;
COMMENT ON COLUMN vsc_config_h.owner_domain_id IS 'The domain that generated or updated the vsc configuration.'
;
COMMENT ON COLUMN vsc_config_h.domain_access_restricted_flag IS 'Identifies the entities access to domains.  ''N'' means visible to owner domain and all sub-domains and ''Y'' means use domains in vsc_config_domain table.'
;
