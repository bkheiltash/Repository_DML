       ,NEW.audit_user_id
       ,NEW.descr
	   ,NEW.i18n   
	   ,NEW.deleted_flag
	   ,NEW.owner_domain_id
	   ,NEW.domain_access_restricted_flag
	   ); 
   ELSEIF TG_OP = 'UPDATE' THEN
     INSERT INTO gsm.entity_status_reason_h(
        audit_operation
       ,audit_datetime
       ,id
	   ,version_number
       ,audit_user_id
       ,descr
	   ,i18n   
	   ,deleted_flag
	   ,owner_domain_id
	   ,domain_access_restricted_flag
       )   
     VALUES  
      ( 'U'
       ,NEW.audit_datetime
       ,NEW.id
       ,NEW.version_number
       ,NEW.audit_user_id
       ,NEW.descr
	   ,NEW.i18n   
	   ,NEW.deleted_flag
	   ,NEW.owner_domain_id
	   ,NEW.domain_access_restricted_flag
	   ); 
   ELSEIF TG_OP = 'DELETE' THEN
     INSERT INTO gsm.entity_status_reason_h(
        audit_operation
       ,audit_datetime
       ,id
	   ,version_number
       ,audit_user_id
       ,descr
	   ,i18n   
	   ,deleted_flag
	   ,owner_domain_id
	   ,domain_access_restricted_flag
       )   
     VALUES  
      ( 'D'
       ,(clock_timestamp() at time zone 'utc')
       ,OLD.id
       ,OLD.version_number+1
       ,OLD.audit_user_id
       ,OLD.descr
	   ,OLD.i18n   
	   ,OLD.deleted_flag
	   ,OLD.owner_domain_id
	   ,OLD.domain_access_restricted_flag
	   ); 
   END IF;
   
   RETURN NULL;
   
END;

$entity_status_reason_trig$
LANGUAGE PLPGSQL
;

