6424,"CREATE TABLE gsm.entity_status_entity_reason(
    id                             integer         GENERATED BY DEFAULT AS IDENTITY (START WITH 1000 INCREMENT BY 1),
    entity_status_type_key_code    varchar(50)     NOT NULL,
    entity_reason_id               integer         NOT NULL,
    audit_datetime                 timestamp(6)    NOT NULL,
    audit_user_id                  integer         NOT NULL
)
;



COMMENT ON COLUMN gsm.entity_status_entity_reason.id IS 'Unique identifier assigned to each entity status entity reason combination.'
;
COMMENT ON COLUMN gsm.entity_status_entity_reason.entity_status_type_key_code IS 'Unique identifier/code assigned to each entity status type in the system.
'
;
COMMENT ON COLUMN gsm.entity_status_entity_reason.entity_reason_id IS 'Unique identifier assigned to each entity reason tyoe.'
;
COMMENT ON COLUMN gsm.entity_status_entity_reason.audit_datetime IS 'Date on which the record was inserted or updated.'
;
COMMENT ON COLUMN gsm.entity_status_entity_reason.audit_user_id IS 'User that updated or inserted the current record.'
;
COMMENT ON TABLE gsm.entity_status_entity_reason IS 'Contains the valid entity status reason combinations managed by the application.'
;

CREATE UNIQUE INDEX entity_status_entity_reason_uk1 ON gsm.entity_status_entity_reason(entity_status_type_key_code)
;
ALTER TABLE gsm.entity_status_entity_reason ADD 
    CONSTRAINT entity_site_entity_reason_pk PRIMARY KEY (id)
;

ALTER TABLE gsm.entity_status_entity_reason ADD CONSTRAINT entity_status_entity_reason_fk1 
    FOREIGN KEY (entity_status_type_key_code)
    REFERENCES gsm.entity_status_type(key_code)
;

ALTER TABLE gsm.entity_status_entity_reason ADD CONSTRAINT Refentity_reason251 
    FOREIGN KEY (entity_reason_id)
    REFERENCES gsm.entity_reason(id)
;
