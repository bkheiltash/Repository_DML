    ""DESCR""                         varchar(100)     NOT NULL,
    ""VERSION_NUMBER""                integer          NOT NULL,
    audit_datetime                  timestamp(6)     NOT NULL,
    audit_user_id                   integer          NOT NULL,
    ""DELETED_FLAG""                  character(1)     DEFAULT 'N' NOT NULL,
    ""I18N""                          varchar(8192),
    CONSTRAINT ENTITY_STATUS_REASON_CK1 CHECK (""DELETED_FLAG"" in ('Y','N'))
)
;



COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".""ID"" IS 'Unique identifier assigned to each Entity Status Reason.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".""ENTITY_STATUS_REASON_TYPE_ID"" IS 'Unique identifier assigned to each reason.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".""DESCR"" IS 'Entity status reason description.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".""VERSION_NUMBER"" IS 'Version of the record being inserted or modified.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".audit_datetime IS 'Date on which the record was inserted or updated.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".audit_user_id IS 'User that updated or inserted the current record.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".""DELETED_FLAG"" IS 'Flag to identify if entity has been logically deleted. Default is N.'
;
COMMENT ON COLUMN ""ENTITY_STATUS_REASON"".""I18N"" IS 'JSON formatted document describing the internationalization for the description in the table.
JSON format:i18n : [locale : <iso639-1_language_code>,description : <localized_description_text>]'
;
COMMENT ON TABLE ""ENTITY_STATUS_REASON"" IS 'Holds the entity status reasons.'
;

CREATE UNIQUE INDEX ""ENTITY_STATUS_REASON_PK"" ON ""ENTITY_STATUS_REASON""(""ID"")
;
CREATE UNIQUE INDEX ""ENTITY_STATUS_REASON_UK1"" ON ""ENTITY_STATUS_REASON""(""ENTITY_STATUS_REASON_TYPE_ID"", ""DESCR"")
;
CREATE INDEX ""ENTITY_STATUS_REASON_I1"" ON ""ENTITY_STATUS_REASON""(audit_datetime)
;
