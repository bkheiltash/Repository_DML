;
COMMENT ON COLUMN vsc_config_h.download_speed_type_key_code IS 'Unique identifier/code assigned to each download speed type.'
;
COMMENT ON TABLE vsc_config_h IS 'Contains a history of the VSC configurations used in the application for a configurable retention period.'
;

CREATE UNIQUE INDEX vsc_config_h_pk ON vsc_config_h(audit_datetime, id)
;
