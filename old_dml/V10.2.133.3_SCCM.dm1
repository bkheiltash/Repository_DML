4357,"CREATE TABLE user_audit_log_h(
    audit_operation         character(1)    NOT NULL,
    audit_datetime          timestamp(6)    NOT NULL,
    id                      integer         NOT NULL,
    audit_user_id           integer         NOT NULL,
    operation_type          varchar(100)    NOT NULL,
    entity_type             varchar(50)     NOT NULL,
    entity_id               integer         NOT NULL,
    entity_display_value    varchar(255)    NOT NULL,
    anonymized_flag         character(1)    NOT NULL,
    operation_id            varchar(50),
    parent_operation_id     varchar(50),
    item_id                 integer,
    item_type               varchar(50),
    item_display_value      varchar(255)
)
;



COMMENT ON COLUMN user_audit_log_h.audit_operation IS 'Identifies whether the record was inserted (I), updated (U) or deleted (D).'
;
COMMENT ON COLUMN user_audit_log_h.audit_datetime IS 'Date on which the record was inserted or updated.'
;
COMMENT ON COLUMN user_audit_log_h.id IS 'System generated identifier that uniquely identifies a specific user audit log entry based on a single transaction.'
;
COMMENT ON COLUMN user_audit_log_h.audit_user_id IS 'User that updated or inserted the current record.'
;
COMMENT ON COLUMN user_audit_log_h.operation_type IS 'The name of the transaction being processed.'
;
COMMENT ON COLUMN user_audit_log_h.entity_type IS 'The name of the entity that is the main target of this transaction. For example, if you were updating the address of a site, site would be the entity_type while site_address would be the item_type.'
;
COMMENT ON COLUMN user_audit_log_h.entity_id IS 'A system generated identifier that uniquely identifies the record that corresponds to the entity_type, and is the record that was inserted/updated/deleted.'
;
COMMENT ON COLUMN user_audit_log_h.entity_display_value IS 'A textual description or name of the record that would be displayed to the User.'
;
COMMENT ON COLUMN user_audit_log_h.anonymized_flag IS 'A Y/N flag indicating if the data has been anonymized so that identifying data is not displayed.'
;
COMMENT ON COLUMN user_audit_log_h.operation_id IS 'An application generated identifier to uniquely identify an operation being performed.'
;
COMMENT ON COLUMN user_audit_log_h.parent_operation_id IS 'An application generated identfier to identify the parent operation.'
;
COMMENT ON COLUMN user_audit_log_h.item_id IS 'A system generated identifier that uniquely identifies the record that corresponds to the item_type, and is the record that was inserted/updated/deleted.'
;
COMMENT ON COLUMN user_audit_log_h.item_type IS 'The sub-entity in a transaction, that is being updated.  For example, if you are updating the site address, site would be the main entity while the site_address would be the sub-entity/item type.'
;
COMMENT ON COLUMN user_audit_log_h.item_display_value IS 'A textual description of the sub-enttiy data you are inserting/updateing/deleting.'
;
COMMENT ON TABLE user_audit_log_h IS 'This table contains the history of the details of user activity that alters data that has been configured to be monitored for a configurable retention period.  It provides an audit log by tracking the entity/object'
;

CREATE UNIQUE INDEX user_audit_log_h_pk ON user_audit_log_h(audit_datetime, id)
;
