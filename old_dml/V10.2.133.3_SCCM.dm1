6037,"CREATE OR REPLACE FUNCTION sru_trigger_function()
RETURNS
TRIGGER AS $sru_trig$

BEGIN

   IF TG_OP = 'INSERT' THEN
     INSERT INTO gsm.sru_h ( audit_operation
                            ,id
                            ,descr
                            ,comm_idn
                            ,serial_number
                            ,asset_ref_number
                            ,model_id
                            ,sru_protocol_type_key_code
                            ,vsc_id
                            ,domain_id
                            ,entity_status_type_key_code
                            ,install_date
                            ,deinstall_date
                            ,purchase_amount
                            ,purchase_date
                            ,revision_number
                            ,deleted_flag
                            ,version_number
                            ,audit_user_id
                            ,audit_datetime
                           )   
     VALUES ( 'I'
             ,NEW.id
             ,NEW.descr
             ,NEW.comm_idn
             ,NEW.serial_number
             ,NEW.asset_ref_number
             ,NEW.model_id
             ,NEW.sru_protocol_type_key_code
             ,NEW.vsc_id
             ,NEW.domain_id
             ,NEW.entity_status_type_key_code
             ,NEW.install_date
             ,NEW.deinstall_date
             ,NEW.purchase_amount
             ,NEW.purchase_date
             ,NEW.revision_number
             ,NEW.deleted_flag
             ,NEW.version_number
             ,NEW.audit_user_id
             ,NEW.audit_datetime
	        ); 
   ELSEIF TG_OP = 'UPDATE' THEN
     INSERT INTO gsm.sru_h ( audit_operation
                            ,id
                            ,descr
                            ,comm_idn
                            ,serial_number
                            ,asset_ref_number
                            ,model_id
                            ,sru_protocol_type_key_code
                            ,vsc_id
                            ,domain_id
                            ,entity_status_type_key_code
                            ,install_date
                            ,deinstall_date
                            ,purchase_amount
                            ,purchase_date
                            ,revision_number
                            ,deleted_flag
                            ,version_number
                            ,audit_user_id
                            ,audit_datetime
                           )   
     VALUES ( 'U'
             ,NEW.id
             ,NEW.descr
             ,NEW.comm_idn
             ,NEW.serial_number
             ,NEW.asset_ref_number
             ,NEW.model_id
             ,NEW.sru_protocol_type_key_code
             ,NEW.vsc_id
             ,NEW.domain_id
             ,NEW.entity_status_type_key_code
             ,NEW.install_date
             ,NEW.deinstall_date
             ,NEW.purchase_amount
             ,NEW.purchase_date
             ,NEW.revision_number
             ,NEW.deleted_flag
             ,NEW.version_number
             ,NEW.audit_user_id
             ,NEW.audit_datetime
	        ); 
   ELSEIF TG_OP = 'DELETE' THEN
     INSERT INTO gsm.sru_h ( audit_operation
                            ,id
                            ,descr
                            ,comm_idn
                            ,serial_number
                            ,asset_ref_number
                            ,model_id
                            ,sru_protocol_type_key_code
                            ,vsc_id
                            ,domain_id
                            ,entity_status_type_key_code
                            ,install_date
                            ,deinstall_date
                            ,purchase_amount
                            ,purchase_date
                            ,revision_number
                            ,deleted_flag
                            ,version_number
                            ,audit_user_id
                            ,audit_datetime
                           )   
     VALUES ( 'D'
             ,OLD.id
             ,OLD.descr
             ,OLD.comm_idn
             ,OLD.serial_number
             ,OLD.asset_ref_number
             ,OLD.model_id
             ,OLD.sru_protocol_type_key_code
             ,OLD.vsc_id
             ,OLD.domain_id
             ,OLD.entity_status_type_key_code
             ,OLD.install_date
             ,OLD.deinstall_date
             ,OLD.purchase_amount
             ,OLD.purchase_date
             ,OLD.revision_number
             ,OLD.deleted_flag
             ,OLD.version_number + 1
             ,OLD.audit_user_id
             ,(clock_timestamp() at time zone 'utc') --audit_datetime
	        ); 
   END IF;
   
   RETURN NULL;
   
END;

$sru_trig$
LANGUAGE PLPGSQL
;

CREATE OR REPLACE TRIGGER sru_trigger

 AFTER INSERT OR UPDATE OR DELETE
    ON gsm.sru
    FOR EACH ROW
    
    EXECUTE FUNCTION sru_trigger_function()
;",0
