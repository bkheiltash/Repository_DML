CREATE OR REPLACE FUNCTION entity_status_reason_domain_trigger_function()
RETURNS
TRIGGER AS $entity_status_reason_domain_trig$

BEGIN

   IF TG_OP = 'INSERT' THEN
     INSERT INTO gsm.entity_status_reason_domain_h(
        audit_operation
       ,audit_datetime
       ,id
       ,audit_user_id
       ,entity_status_reason_id
	   ,domain_id
	   ,deleted_flag
       )   
     VALUES  
      ( 'I'
       ,NEW.audit_datetime
       ,NEW.id
       ,NEW.audit_user_id
       ,NEW.entity_status_reason_id
	   ,NEW.domain_id
	   ,NEW.deleted_flag
	   ); 
   ELSEIF TG_OP = 'UPDATE' THEN
     INSERT INTO gsm.entity_status_reason_domain_h(
        audit_operation
       ,audit_datetime
       ,id
       ,audit_user_id
       ,entity_status_reason_id
	   ,domain_id
	   ,deleted_flag
       )   
     VALUES  
      ( 'U'
       ,NEW.audit_datetime
       ,NEW.id
       ,NEW.audit_user_id
       ,NEW.entity_status_reason_id
	   ,NEW.domain_id
	   ,NEW.deleted_flag
	   ); 
   ELSEIF TG_OP = 'DELETE' THEN
     INSERT INTO gsm.entity_status_reason_domain_h(
        audit_operation
       ,audit_datetime
       ,id
       ,audit_user_id
       ,entity_status_reason_id
	   ,domain_id
	   ,deleted_flag
       )   
     VALUES  
      ( 'D'
       ,(clock_timestamp() at time zone 'utc')
       ,OLD.id
       ,OLD.version_number+1
       ,OLD.audit_user_id
       ,OLD.entity_status_reason_id
	   ,OLD.domain_id
	   ,OLD.deleted_flag
	   ); 
   END IF;
   
   RETURN NULL;
   
END;

$entity_status_reason_domain_trig$
LANGUAGE PLPGSQL
;

CREATE OR REPLACE TRIGGER entity_status_reason_domain_trigger

 AFTER INSERT OR UPDATE OR DELETE
    ON gsm.entity_status_reason_domain
    FOR EACH ROW
    
    EXECUTE FUNCTION entity_status_reason_domain_trigger_function()
;
