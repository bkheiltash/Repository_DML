;
COMMENT ON COLUMN system_news_message_domain.deleted_flag IS 'Identifies if the domain has been removed from the Traits access.  '
;
COMMENT ON TABLE system_news_message_domain IS 'Identifies which domains can use which special messages.  Special messages can be assigned to entities that have access to the same domains if the domain_access_list_flag in the special_msg table is set to ''Y''.'
;

CREATE UNIQUE INDEX system_news_message_domain_pk ON system_news_message_domain(id)
;
ALTER TABLE system_news_message_domain ADD 
