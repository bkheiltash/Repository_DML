    audit_datetime       timestamp(6)     NOT NULL,
    id                   integer          NOT NULL,
    audit_user_id        integer          NOT NULL,
    user_audit_log_id    integer          NOT NULL,
    level                integer,
    attribute_name       character(10)    NOT NULL,
    old_value            varchar(1000),
    new_value            varchar(1000)
)
;



COMMENT ON COLUMN user_audit_log_reference_h.audit_operation IS 'Identifies whether the record was inserted (I), updated (U) or deleted (D).'
;
COMMENT ON COLUMN user_audit_log_reference_h.audit_datetime IS 'Date on which the record was inserted or updated.'
;
COMMENT ON COLUMN user_audit_log_reference_h.id IS 'System gernerated identifier that uniquely identifies a single change to a data value.'
;
COMMENT ON COLUMN user_audit_log_reference_h.audit_user_id IS 'User that updated or inserted the current record.'
;
COMMENT ON COLUMN user_audit_log_reference_h.user_audit_log_id IS 'System genrated identifier that uniquely identifies a specific user audit log entry based on a single transaction.'
;
COMMENT ON COLUMN user_audit_log_reference_h.level IS 'Undefined.'
;
COMMENT ON COLUMN user_audit_log_reference_h.attribute_name IS 'The name of the data that was inserted/updated/deleted.'
;
COMMENT ON COLUMN user_audit_log_reference_h.old_value IS 'The value of the data prior to the insert/update/delete. On insert old is null and new is inserted value, on delete new is null and old is the deleted value.'
;
COMMENT ON COLUMN user_audit_log_reference_h.new_value IS 'The value of the data after the insert/update/delete. On insert old is null and new is inserted value, on delete new is null and old is the deleted value.'
;
COMMENT ON TABLE user_audit_log_reference_h IS 'Stored the pre & post values for data that was updated.'
;

CREATE UNIQUE INDEX user_audit_log_reference_h_pk ON user_audit_log_reference_h(audit_datetime, id)
