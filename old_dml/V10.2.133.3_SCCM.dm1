4302,"CREATE TABLE trait_h(
    audit_operation                  character(1)    NOT NULL,
    audit_datetime                   timestamp(6)    NOT NULL,
    id                               integer         NOT NULL,
    version_number                   integer         NOT NULL,
    audit_user_id                    integer         NOT NULL,
    descr                            varchar(100)    NOT NULL,
    trait_type_id                    integer         NOT NULL,
    deleted_flag                     character(1)    NOT NULL,
    source_entity_ref                integer,
    parent_trait_id                  integer,
    owner_domain_id                  integer         NOT NULL,
    domain_access_restricted_flag    character(1)    NOT NULL
)
;



COMMENT ON COLUMN trait_h.audit_operation IS 'Identifies whether the record was inserted (I), updated (U) or deleted (D).'
;
COMMENT ON COLUMN trait_h.audit_datetime IS 'Date on which the record was inserted or updated.'
;
COMMENT ON COLUMN trait_h.id IS 'Unique identifier assigned to each trait.'
;
COMMENT ON COLUMN trait_h.version_number IS 'Version of the record being inserted or modified.'
;
COMMENT ON COLUMN trait_h.audit_user_id IS 'User that updated or inserted the current record.'
;
COMMENT ON COLUMN trait_h.descr IS 'Description of the trait.'
;
COMMENT ON COLUMN trait_h.trait_type_id IS 'Unique identifier assigned to each trait type.'
;
COMMENT ON COLUMN trait_h.deleted_flag IS 'Flag to identify if entity has been logically deleted. Default is N.'
;
COMMENT ON COLUMN trait_h.source_entity_ref IS 'ID of the entity which resulted in this trait being generated; NULL for user generated traits.
'
;
COMMENT ON COLUMN trait_h.parent_trait_id IS 'Parent trait id.'
;
COMMENT ON COLUMN trait_h.owner_domain_id IS 'The domain that generated or updated the trait.'
;
COMMENT ON COLUMN trait_h.domain_access_restricted_flag IS 'Identifies the entities access to domains.  ''N'' means visible to owner domain and all sub-domains and ''Y'' means use domains in trait_domain table.'
;
COMMENT ON TABLE trait_h IS 'Contains the traits used in the application.'
;

CREATE UNIQUE INDEX trait_h_pk ON trait_h(id, audit_datetime)
;
ALTER TABLE trait_h ADD CONSTRAINT trait_fk2_1 
    FOREIGN KEY (parent_trait_id, audit_datetime)
    REFERENCES trait_h(id, audit_datetime)
;
