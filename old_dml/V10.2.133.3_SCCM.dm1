1793,"CREATE TABLE ""AGE_VERIFICATION_DVC_CFG_PROFILE""(
    ""ID""                             integer         NOT NULL,
    ""AGE_VERIFICATION_ENABLED_FLAG""  character(1)    DEFAULT 'N' NOT NULL,
    ""IDLE_TIMER""                     bigint,
    ""FIELD_LENGTH""                   integer,
    ""REQUIRED_FOR_PLAY_FLAG""         character(1)    DEFAULT 'Y' NOT NULL,
    CONSTRAINT AGE_VERIFICATION_DVC_CFG_PROFILE_CK1 CHECK (AGE_VERIFICATION_ENABLED_FLAG in ('Y','N')),
    CONSTRAINT AGE_VERIFICATION_DVC_CFG_PROFILE_CK2 CHECK (REQUIRED_FOR_PLAY_FLAG in ('Y','N'))
)
;



COMMENT ON COLUMN ""AGE_VERIFICATION_DVC_CFG_PROFILE"".""ID"" IS 'Unique identifier assigned to configuration profile.'
;
COMMENT ON COLUMN ""AGE_VERIFICATION_DVC_CFG_PROFILE"".""AGE_VERIFICATION_ENABLED_FLAG"" IS 'Identifies whether age verification is enabled or not.'
;
COMMENT ON COLUMN ""AGE_VERIFICATION_DVC_CFG_PROFILE"".""IDLE_TIMER"" IS 'Idle time before age verification screen shows on EGM.'
;
COMMENT ON COLUMN ""AGE_VERIFICATION_DVC_CFG_PROFILE"".""FIELD_LENGTH"" IS 'Idenitifies the age verification field length.  Allowable values are 6 or 10.'
;
COMMENT ON COLUMN ""AGE_VERIFICATION_DVC_CFG_PROFILE"".""REQUIRED_FOR_PLAY_FLAG"" IS 'Indicates whether the EGM MUST be disabled if the device is disabled by either the host or EGM.'
;
COMMENT ON TABLE ""AGE_VERIFICATION_DVC_CFG_PROFILE"" IS 'Contains the parameters that are associated to the age verification device configuration profile.'
;

CREATE UNIQUE INDEX ""AGE_VERIFICATION_DVC_CFG_PROFILE_PK"" ON ""AGE_VERIFICATION_DVC_CFG_PROFILE""(""ID"")
;
ALTER TABLE ""AGE_VERIFICATION_DVC_CFG_PROFILE"" ADD CONSTRAINT AGE_VERIFICATION_DVC_CFG_PROFILE_FK1 
    FOREIGN KEY (""ID"")
    REFERENCES ""CFG_PROFILE""(""ID"")
;
