6153,"CREATE TABLE gsm.sru_tracking_operation(
    id                                      integer         GENERATED BY DEFAULT AS IDENTITY (START WITH 1000 INCREMENT BY 1),
    old_sru_id                              integer,
    new_sru_id                              integer,
    old_vsc_id                              integer,
    new_vsc_d                               integer,
    serial_number                           varchar(32)     NOT NULL,
    operation_datetime                      timestamp(6)    NOT NULL,
    version_number                          integer         NOT NULL,
    audit_datetime                          timestamp(6)    NOT NULL,
    audit_user_id                           integer         NOT NULL,
    sru_tracking_operation_type_key_code    varchar(50)     NOT NULL
)
;



COMMENT ON COLUMN gsm.sru_tracking_operation.old_sru_id IS 'A system generated identifier that uniquely identifies the SRU that is being moved, removed or replaced. On install (add) this would be null.'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.new_sru_id IS 'A system generated identifier that uniquely identifies the SRU that is being added for the first time or replacing the old SRU'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.old_vsc_id IS 'A system generated identifier that uniquely identifies the VSC that this SRU was being moved or removed from. On an install (add), this would be null.'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.new_vsc_d IS 'A system generated identifier that uniquely identifies the VSC that this SRU is being connected o when being added, moved, or removed.'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.serial_number IS 'Serial Number of the SRU being removed, moved, replaced  or installed. For a replace operation, the serial number is expected to remain the same.
'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.operation_datetime IS 'The date and time that the tracked operation occurred.'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.audit_datetime IS 'The date and time that this record was last updated.'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.audit_user_id IS 'A system generated identifier that uniquely identifies the user that last updated this record.'
;
COMMENT ON COLUMN gsm.sru_tracking_operation.sru_tracking_operation_type_key_code IS 'A value that uniquely identifies the operation that was performed that resulted in this record being created.
'
;

ALTER TABLE gsm.sru_tracking_operation ADD 
    CONSTRAINT sru_tracking_operation_pk PRIMARY KEY (id)
;

ALTER TABLE gsm.sru_tracking_operation ADD CONSTRAINT Refegm/sru_tracking_operation_type_??????235 
    FOREIGN KEY (sru_tracking_operation_type_key_code)
    REFERENCES gsm.""egm/sru_tracking_operation_type_??????""(key_code)
;
