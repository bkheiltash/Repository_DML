1296,"

'Basic function that generates update trigger for DB2 Universal and OS/390 v6

Sub Main

	Dim Result As String
	Dim Header As String
    Dim Beginn As String
    Dim Body   As String
	Dim Attr   As AttributeObj

	'Standard trigger body beginning for update action

	Header = "" AFTER UPDATE ON "" & CurrEntity.TableName & vbCrLf
	Header = Header & ""REFERENCING OLD AS OLD NEW AS NEW"" & vbCrLf
	Header = Header & ""FOR EACH ROW MODE DB2SQL"" & vbCrLf
	
	'Emit the trigger code for each parent relationship for this table

	Dim Rel As Relationship
	Dim Action As String
	NameCount% = 0

	For Each Rel In CurrEntity.ParentRelationships

		Action = Rel.ParentAction(""UPDATE"")

		If Action <> ""NONE"" Then
		    Beginn = ""CREATE TRIGGER "" & TriggerName

			If NameCount% > 0 Then
			    Beginn = Beginn & CStr(NameCount%)
			End If
			NameCount% = NameCount% + 1
			Beginn = Beginn & Header
		End If

		If Action = ""RESTRICT"" Then
			Body = Db2DefParUpdtRstr(Rel, TriggerName)
            If Body <> """" Then Result = Result & Beginn & Body
		ElseIf Action = ""CASCADE"" Then
			Body = Db2DefParUpdtCasc(Rel)
            If Body <> """" Then Result = Result & Beginn & Body
		ElseIf Action = ""SETNULL"" Then
			Body = Db2DefParUpdtSN(Rel)
            If Body <> """" Then Result = Result & Beginn & Body
		End If

	Next Rel

	For Each Rel In CurrEntity.ChildRelationships

		Action = Rel.ChildAction(""UPDATE"")

		If Action = ""RESTRICT"" Then
		    Beginn = ""CREATE TRIGGER "" & TriggerName

			If NameCount% > 0 Then
			    Beginn = Beginn & CStr(NameCount%)
			End If
			NameCount% = NameCount% + 1
			Beginn = Beginn & Header

			Body = Db2DefChUpdtRstr(Rel, TriggerName)
            If Body <> """" Then Result = Result & Beginn & Body
		End If

	Next Rel

	'Display result in message box (remove ' from line below)
	'MsgBox(Result)

	'Assign result SQL to external string for execution

	ResultString = Result

End Sub
",0
1298,"

'Basic function that generates delete trigger for DB2 UDB and OS/390 v6

Sub Main

	Dim Result As String
	Dim Header As String
	Dim Beginn As String
    Dim Body   As String
	Dim Attr   As AttributeObj

	'Standard trigger body beginning for delete action

	Header = "" AFTER DELETE ON "" & CurrEntity.TableName & vbCrLf
	Header = Header & ""REFERENCING OLD AS OLD"" & vbCrLf
	Header = Header & ""FOR EACH ROW MODE DB2SQL"" & vbCrLf
	
	'Emit the trigger code for each parent relationship for this table

	Dim Rel As Relationship
	Dim Action As String
	NameCount% = 0

	For Each Rel In CurrEntity.ParentRelationships
	
		Action = Rel.ParentAction(""DELETE"")

		If Action <> ""NONE"" Then
		    Beginn = ""CREATE TRIGGER "" & TriggerName

			If NameCount% > 0 Then
			    Beginn = Beginn & CStr(NameCount%)
			End If
			NameCount% = NameCount% + 1
			Beginn = Beginn & Header
		End If

		If Action = ""RESTRICT"" Then
			Body = Db2DefParDelRstr(Rel, TriggerName)
			If Body <> """" Then
				Result = Result & Beginn & Body
			End If
		ElseIf Action = ""CASCADE"" Then
			Body = Db2DefParDelCasc(Rel)
			If Body <> """" Then
				Result = Result & Beginn & Body
			End If
		ElseIf Action = ""SETNULL"" Then
			Body = Db2DefParDelSN(Rel)
			If Body <> """" Then
				Result = Result & Beginn & Body
			End If
		End If

	Next Rel

	'Standard delete trigger does nothing on child delete

	'Display result in message box (remove ' from line below)
	'MsgBox(Result)

	'Assign result SQL to external string for execution

	ResultString = Result

End Sub
