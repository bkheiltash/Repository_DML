    sru_protocol_type_key_code     varchar(50)       NOT NULL,
    vsc_id                         integer           NOT NULL,
    domain_id                      integer           NOT NULL,
    entity_status_type_key_code    varchar(50)       NOT NULL,
    install_date                   date,
    deinstall_date                 date,
    purchase_amount                decimal(19, 4),
    purchase_date                  date,
    under_repair_flag              char(1)           NOT NULL,
    revision_number                integer           NOT NULL,
    deleted_flag                   char(1)           NOT NULL,
    version_number                 integer           NOT NULL,
    audit_user_id                  integer           NOT NULL,
    audit_datetime                 timestamp(6)      NOT NULL,
    CONSTRAINT sru_ck1 CHECK (under_repair_flag IN ('Y', 'N')),
    CONSTRAINT self_redemption_unit_ck1 CHECK (deleted_flag IN ('Y', 'N')),
    CONSTRAINT self_redemption_unit_pk PRIMARY KEY (id), 
    CONSTRAINT Refentity_status_type225 FOREIGN KEY (entity_status_type_key_code)
    REFERENCES gsm.entity_status_type(key_code),
    CONSTRAINT Refvsc226 FOREIGN KEY (vsc_id)
    REFERENCES gsm.vsc(id),
    CONSTRAINT Refsru_protocol_type236 FOREIGN KEY (sru_protocol_type_key_code)
    REFERENCES gsm.sru_protocol_type(key_code),
    CONSTRAINT Refmodel243 FOREIGN KEY (model_id)
    REFERENCES gsm.model(id)
)
;
