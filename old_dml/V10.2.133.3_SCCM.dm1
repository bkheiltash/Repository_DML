2334,"{\rtf1\ansi\ansicpg1252\deff0{\fonttbl{\f0\fnil\fcharset0 MS Shell Dlg;}}
\viewkind4\uc1\pard\lang1033\f0\fs17 The sub-entity in a transaction, that is being updated.  For example, if you are updating the site address, site would be the main entity while the site_address would be the sub-entity/item type.\par
}
",0
5838,"CREATE TABLE vendor_entity_type(
    id                      integer        GENERATED BY DEFAULT AS IDENTITY (START WITH 1000 INCREMENT BY 1),
    vendor_id               integer        NOT NULL,
    entity_type_key_code    varchar(50)    NOT NULL
)
;



COMMENT ON COLUMN vendor_entity_type.id IS 'System generated identifier that uniquely identifies a relationship between a vendor and the types of entities they provide.'
;
COMMENT ON COLUMN vendor_entity_type.vendor_id IS 'Unique identifier assigned to each vendor.'
;
COMMENT ON COLUMN vendor_entity_type.entity_type_key_code IS 'Unique identifier/code assigned to each entity type.'
;

CREATE UNIQUE INDEX vendor_entity_type_pk ON vendor_entity_type(id)
;
ALTER TABLE vendor_entity_type ADD CONSTRAINT Refvendor238 
    FOREIGN KEY (vendor_id)
    REFERENCES vendor(id)
;

ALTER TABLE vendor_entity_type ADD CONSTRAINT Refentity_type239 
    FOREIGN KEY (entity_type_key_code)
    REFERENCES entity_type(key_code)
;
",0
5839,"CREATE TABLE trait_type_entity_type(
    id                      integer        GENERATED BY DEFAULT AS IDENTITY (START WITH 1000 INCREMENT BY 1),
    trait_type_id           integer        NOT NULL,
    entity_type_key_code    varchar(50)    NOT NULL
)
;



COMMENT ON COLUMN trait_type_entity_type.id IS 'System generated identifier that uniquely identifies the relationship between a trait_type and the entities to which it applies.'
;
COMMENT ON COLUMN trait_type_entity_type.trait_type_id IS 'Unique identifier assigned to trait type in the system.'
;
COMMENT ON COLUMN trait_type_entity_type.entity_type_key_code IS 'Unique identifier/code assigned to each entity type.'
;
COMMENT ON TABLE trait_type_entity_type IS 'Contains the relationships between the trait_types that are supported by the system and the entities to which they apply.'
;

CREATE UNIQUE INDEX trait_type_entity_type_pk ON trait_type_entity_type(id)
;
ALTER TABLE trait_type_entity_type ADD CONSTRAINT Reftrait_type240 
    FOREIGN KEY (trait_type_id)
    REFERENCES trait_type(id)
;

ALTER TABLE trait_type_entity_type ADD CONSTRAINT Refentity_type241 
    FOREIGN KEY (entity_type_key_code)
    REFERENCES entity_type(key_code)
;
